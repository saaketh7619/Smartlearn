datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
  Olympiad
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  phone         String?
  passwordHash  String
  role          Role            @default(STUDENT)
  avatar        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  notifications  Notification[]
  sentMessages   Message[]      @relation("SentMessages")
  receivedMsgs   Message[]      @relation("ReceivedMessages")
  supportTickets SupportTicket[]
}

model StudentProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           String
  school          String
  rollNumber      String
  xp              Int              @default(150)
  level           Int              @default(1)
  coins           Int              @default(45)
  streakDays      Int              @default(3)
  enrollments     CourseEnrollment[]
  submissions     TestSubmission[]
  attendance      Attendance[]
  userBadges      UserBadge[]
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      String
  experienceYears Int      @default(5)
  rating          Float    @default(4.8)
  createdTests    Test[]
}

model ParentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childrenIds     String[]
  preferredLang   String   @default("en")
}

model Course {
  id              String             @id @default(cuid())
  title           String
  description     String
  subject         String
  grade           String
  difficulty      Difficulty         @default(Intermediate)
  thumbnail       String
  instructorName  String
  durationHours   Int                @default(12)
  modules         Module[]
  enrollments     CourseEnrollment[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  lessons   Lesson[]
}

model Lesson {
  id             String           @id @default(cuid())
  moduleId       String
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  durationMinutes Int
  type           String           @default("video")
  content        String?
  progress       LessonProgress[]
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Float    @default(0.0)
  createdAt DateTime @default(now())
}

model LessonProgress {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  completed Boolean  @default(false)
}

model Test {
  id                String           @id @default(cuid())
  title             String
  subject           String
  grade             String
  durationMinutes   Int
  totalMarks        Int
  isAdaptive        Boolean          @default(true)
  antiCheatEnabled  Boolean          @default(true)
  teacherId         String?
  teacher           TeacherProfile?  @relation(fields: [teacherId], references: [id])
  questions         Question[]
  submissions       TestSubmission[]
  createdAt         DateTime         @default(now())
}

model Question {
  id            String     @id @default(cuid())
  testId        String
  test          Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  text          String
  options       String[]
  correctIndex  Int
  explanation   String
  topic         String
  difficulty    Difficulty @default(Medium)
}

model TestSubmission {
  id                  String         @id @default(cuid())
  testId              String
  test                Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score               Int
  maxScore            Int
  percentage          Float
  tabSwitchesDetected Int            @default(0)
  completedAt         DateTime       @default(now())
}

model Attendance {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean        @default(true)
}

model Badge {
  id          String      @id @default(cuid())
  title       String
  description String
  icon        String
  xpReward    Int
  userBadges  UserBadge[]
}

model UserBadge {
  id        String         @id @default(cuid())
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  earnedAt  DateTime       @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("alert")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  timestamp  DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  priority  String   @default("Medium")
  status    String   @default("Open")
  createdAt DateTime @default(now())
}
